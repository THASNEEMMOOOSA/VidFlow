# Application
APP_NAME=VidFlow
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/vidflow
DATABASE_TEST_URL=postgresql://postgres:postgres@postgres:5432/vidflow_test

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=vidflow-dev
S3_BUCKET_PROCESSED=vidflow-processed-dev

# CloudFront
CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30